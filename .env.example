# Hermes-Desktop-Web configuration.
# Copy to .env and adjust. `docker compose up -d --build` reads these.

# Port the web UI listens on (host side).
PORT=4000

# Hermes agent backend (host:port or http(s)://host:port).
# Self-host: the agent's `hermes dashboard`/`hermes serve` endpoint.
#   - agent on this host (docker): host.docker.internal:9119
#   - agent on this host (bare):   127.0.0.1:9119
#   - agent on a LAN/Tailscale:    100.64.0.1:9119  (your tailnet IP)
#   - agent containerized:         hermes-agent:9119 (compose service name)
HERMES_TARGET=host.docker.internal:9119

# Filesystem door root — the directories the web UI's Files rail can browse.
# In docker this maps to the workspace volume.
WEB_FS_ROOT=/workspace

# Default working directory for the in-browser terminal.
HERMES_TERM_CWD=/workspace

# Desktop-plugins directory (each <name>/plugin.js). Empty/omitted = no plugins.
HERMES_PLUGINS_DIR=/plugins
